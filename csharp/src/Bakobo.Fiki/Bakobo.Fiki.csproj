<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 reaches .NET Framework 4.8, where many of the callers this.i @07wstqk7 names
       still run; net10.0 is the current LTS (this.i @5l4p36rl). The code is written to the
       netstandard2.0 API floor, so both assets are the same source. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Bakobo.Fiki</RootNamespace>

    <PackageId>Bakobo.Fiki</PackageId>
    <Version>0.6.0</Version>
    <Authors>Bakobo</Authors>
    <Description>Sign and verify HTTP requests and responses with a bare Ed25519 key as the identifier. Standard RFC 9421, no KERI dependencies.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bakobo/fiki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bakobo/fiki</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rfc9421;http-message-signatures;ed25519;keri;aid</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bakobo.Fiki.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The one runtime dependency. .NET has no Ed25519 in its standard library, and BouncyCastle is
       pure managed code, so nothing native has to load inside a caller's container
       (this.i @5l4p36rl). Pinned exactly. -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>

</Project>
