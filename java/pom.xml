<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bakobo</groupId>
  <artifactId>fiki</artifactId>
  <version>0.8.0</version>

  <name>fiki</name>
  <description>Sign and verify HTTP requests with a bare Ed25519 key as the identifier. Standard RFC 9421, no KERI dependencies.</description>
  <url>https://github.com/bakobo/fiki</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <!-- Maven Central requires name, description, url, licenses, developers and scm, and refuses a
       deployment that lacks any of them (https://central.sonatype.org/publish/requirements/). -->
  <developers>
    <developer>
      <name>Bakobo</name>
      <organization>Bakobo</organization>
      <organizationUrl>https://github.com/bakobo</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/bakobo/fiki.git</connection>
    <developerConnection>scm:git:https://github.com/bakobo/fiki.git</developerConnection>
    <url>https://github.com/bakobo/fiki</url>
    <tag>java/v${project.version}</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/bakobo/fiki/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- No runtime dependencies. Ed25519 has been in the JDK since 15 and SHA-2 since forever, and
       the RFC 8941 subset is hand-rolled for the reason every port hand-rolls it (this.i
       @2q9gv70t, @2tt6fmc0). The two below are TEST scope only: JUnit to run the suite, and a
       JSON reader for the shared vectors. A consumer of this artifact inherits neither. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>

  <!-- What a Maven Central release adds to an ordinary build, and only that: the sources and javadoc
       jars Central requires beside every jar, a PGP signature on each file, and the Central
       Portal's own publishing plugin. Kept in a profile so that `mvn test` and CI never need a
       signing key. release-java.yml activates it; docs/releasing.md says where the credentials come
       from. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- The bc signer reads the armored key from MAVEN_GPG_KEY and its passphrase from
               MAVEN_GPG_PASSPHRASE, so the runner needs no gpg keyring and nothing is imported into
               one. -Dgpg.skip turns signing off for a local dry run. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
