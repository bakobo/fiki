<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# port's differential runner, a project of its own so the port's solution gains nothing.
       It references the library in this repository; System.Text.Json is in the net10.0 shared
       framework, as it is for the port's own tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../csharp/src/Bakobo.Fiki/Bakobo.Fiki.csproj" />
  </ItemGroup>

</Project>
