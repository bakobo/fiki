<Project Sdk="Microsoft.NET.Sdk">

  <!-- Release smoke test for Bakobo.Fiki, restored from nuget.org, never built from source.
       release-csharp.yml passes the tag's version as -p:FikiVersion=X.Y.Z. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bakobo.Fiki" Version="[$(FikiVersion)]" />
  </ItemGroup>

</Project>
